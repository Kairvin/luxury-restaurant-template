"use client";

import Image from "next/image";

import {
  useLayoutEffect,
  useRef,
} from "react";

import gsap from "gsap";

import {
  ScrollTrigger,
} from "gsap/ScrollTrigger";

import type {
  ClosingSectionContent,
} from "@/types/homepage";

import {
  Container,
} from "@/components/ui/Container";

import {
  PremiumHoverLink,
} from "@/components/ui/PremiumHoverLink";

gsap.registerPlugin(
  ScrollTrigger
);

export function ClosingSection({
  content,
}: {
  content:
    ClosingSectionContent;
}) {
  const rootRef =
    useRef<HTMLDivElement>(null);

  const imageRef =
    useRef<HTMLDivElement>(null);

  const contentRef =
    useRef<HTMLDivElement>(null);


  useLayoutEffect(() => {
    const root =
      rootRef.current;

    if (!root) {
      return;
    }

    const panel =
      root.closest(
        "[data-rolling-panel]"
      ) as HTMLElement | null;

    if (!panel) {
      return;
    }


    const reducedMotion =
      window.matchMedia(
        "(prefers-reduced-motion: reduce)"
      ).matches;

    if (reducedMotion) {
      return;
    }


    const ctx =
      gsap.context(() => {

        gsap.set(
          imageRef.current,
          {
            scale:
              1.04,

            force3D:
              true,
          }
        );


        gsap.fromTo(
          imageRef.current,

          {
            yPercent:
              1,
          },

          {
            yPercent:
              -1,

            ease:
              "none",

            scrollTrigger: {
              trigger:
                panel,

              start:
                "top bottom",

              end:
                "bottom top",

              scrub:
                true,
            },
          }
        );


        gsap.fromTo(
          contentRef.current,

          {
            y:
              34,

            opacity:
              0,
          },

          {
            y:
              0,

            opacity:
              1,

            duration:
              1.1,

            ease:
              "power4.out",

            scrollTrigger: {
              trigger:
                panel,

              start:
                "top 68%",
            },
          }
        );

      }, root);


    return () =>
      ctx.revert();

  }, []);


  return (
    <div
      ref={rootRef}

      className={[
        "relative",

        "h-full",

        "overflow-hidden",

        "bg-background",

        "text-white",
      ].join(" ")}
    >

      {content.image && (

        <div
          ref={imageRef}

          className={[
            "absolute",

            "-inset-[4%]",

            "will-change-transform",
          ].join(" ")}
        >

          <Image
            src={
              content.image.src
            }

            alt={
              content.image.alt
            }

            fill

            sizes="100vw"

            className="object-cover"
          />

        </div>

      )}


      <div
        aria-hidden="true"

        className={[
          "absolute",

          "inset-0",

          "bg-black/68",
        ].join(" ")}
      />


      <div
        aria-hidden="true"

        className={[
          "absolute",

          "inset-0",

          "bg-[radial-gradient(circle_at_22%_55%,rgba(140,0,20,0.42),transparent_48%)]",
        ].join(" ")}
      />


      {/*
       * Same +12svh content offset.
       */}

      <div
        className={[
          "absolute",

          "left-0",
          "right-0",

          "top-[12svh]",

          "h-svh",
        ].join(" ")}
      >

        <Container
          className={[
            "flex",

            "h-full",

            "flex-col",

            "justify-end",

            "pb-10",
            "pt-32",
          ].join(" ")}
        >

          <div
            ref={contentRef}

            className="pb-[8vh]"
          >

            {content.scriptAccent && (

              <p
                className={[
                  "font-accent",

                  "text-6xl",

                  "leading-none",

                  "text-primary",

                  "md:text-8xl",
                ].join(" ")}
              >
                {
                  content.scriptAccent
                }
              </p>

            )}


            <div
              className={[
                "mt-7",

                "flex",

                "flex-col",

                "gap-10",

                "lg:flex-row",

                "lg:items-end",

                "lg:justify-between",
              ].join(" ")}
            >

              <h2
                className={[
                  "max-w-[950px]",

                  "font-display",

                  "text-[clamp(4rem,8vw,9rem)]",

                  "leading-[0.82]",

                  "tracking-[-0.06em]",
                ].join(" ")}
              >
                {
                  content.title
                }
              </h2>


              {content.action && (

                <PremiumHoverLink
                  href={
                    content.action.href
                  }
                >
                  {
                    content.action.label
                  }
                </PremiumHoverLink>

              )}

            </div>

          </div>


          <footer
            id="contact"

            className={[
              "grid",

              "gap-6",

              "border-t",

              "border-white/15",

              "pt-5",

              "font-body",

              "text-[9px]",

              "uppercase",

              "tracking-[0.18em]",

              "text-white/45",

              "md:grid-cols-3",
            ].join(" ")}
          >

            <span>
              ROUGE
            </span>

            <span className="md:text-center">
              New York · United States
            </span>

            <span className="md:text-right">
              © 2026
            </span>

          </footer>

        </Container>

      </div>

    </div>
  );
}
