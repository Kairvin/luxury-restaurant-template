"use client";

import Image from "next/image";

import {
  useLayoutEffect,
  useRef,
} from "react";

import gsap from "gsap";

import {
  ScrollTrigger,
} from "gsap/ScrollTrigger";

import type {
  GalleryTeaserContent,
  MenuTeaserContent,
  StorySectionContent,
} from "@/types/homepage";

import {
  Container,
} from "@/components/ui/Container";

import {
  PremiumHoverLink,
} from "@/components/ui/PremiumHoverLink";

gsap.registerPlugin(
  ScrollTrigger
);

type StackContent =
  | StorySectionContent
  | MenuTeaserContent
  | GalleryTeaserContent;

type Props = {
  section: StackContent;
  index: number;
};

export function StackSection({
  section,
  index,
}: Props) {
  const rootRef =
    useRef<HTMLDivElement>(null);

  const parallaxRef =
    useRef<HTMLDivElement>(null);

  const zoomRef =
    useRef<HTMLDivElement>(null);

  const contentRef =
    useRef<HTMLDivElement>(null);


  useLayoutEffect(() => {
    const root =
      rootRef.current;

    if (!root) {
      return;
    }

    const panel =
      root.closest(
        "[data-rolling-panel]"
      ) as HTMLElement | null;

    if (!panel) {
      return;
    }


    const reducedMotion =
      window.matchMedia(
        "(prefers-reduced-motion: reduce)"
      ).matches;

    if (reducedMotion) {
      return;
    }


    const ctx =
      gsap.context(() => {

        gsap.set(
          parallaxRef.current,
          {
            scale:
              1.045,

            force3D:
              true,
          }
        );


        gsap.set(
          zoomRef.current,
          {
            scale:
              1,

            force3D:
              true,

            transformOrigin:
              "50% 50%",
          }
        );


        /*
         * VERY restrained photography parallax.
         *
         * This is separate from panel movement.
         */
        gsap.fromTo(
          parallaxRef.current,

          {
            yPercent:
              1,
          },

          {
            yPercent:
              -1,

            ease:
              "none",

            scrollTrigger: {
              trigger:
                panel,

              start:
                "top bottom",

              end:
                "bottom top",

              scrub:
                true,
            },
          }
        );


        /*
         * Copy reveal.
         */
        gsap.fromTo(
          contentRef.current,

          {
            y:
              34,

            opacity:
              0,
          },

          {
            y:
              0,

            opacity:
              1,

            duration:
              1.05,

            ease:
              "power4.out",

            scrollTrigger: {
              trigger:
                panel,

              start:
                "top 68%",

              toggleActions:
                "play none none reverse",
            },
          }
        );

      }, root);


    return () =>
      ctx.revert();

  }, []);


  function zoomIn() {
    gsap.to(
      zoomRef.current,
      {
        scale:
          1.035,

        duration:
          1.15,

        ease:
          "power3.out",

        overwrite:
          "auto",

        force3D:
          true,
      }
    );
  }


  function zoomOut() {
    gsap.to(
      zoomRef.current,
      {
        scale:
          1,

        duration:
          1.05,

        ease:
          "power3.inOut",

        overwrite:
          "auto",

        force3D:
          true,
      }
    );
  }


  const isRight =
    section.alignment ===
    "right";


  return (
    <div
      ref={rootRef}

      data-rolling-content

      /*
       * Fills the entire 112vh visual.
       */
      className={[
        "relative",

        "h-full",

        "overflow-hidden",

        "text-white",
      ].join(" ")}
    >

      {/* ================================================================ */}
      {/* PHOTO                                                            */}
      {/* ================================================================ */}

      <div
        ref={parallaxRef}

        className={[
          "absolute",

          "-inset-[4%]",

          "will-change-transform",
        ].join(" ")}
      >

        <div
          ref={zoomRef}

          className={[
            "absolute",

            "inset-0",

            "will-change-transform",
          ].join(" ")}
        >

          <Image
            src={
              section.image.src
            }

            alt={
              section.image.alt
            }

            fill

            sizes="100vw"

            className="object-cover"

            style={{
              objectPosition:
                `${
                  section.image
                    .focalPoint?.x ??
                  50
                }% ${
                  section.image
                    .focalPoint?.y ??
                  50
                }%`,
            }}
          />

        </div>

      </div>


      {/* ================================================================ */}
      {/* CONTRAST                                                         */}
      {/* ================================================================ */}

      <div
        aria-hidden="true"

        className={[
          "absolute",

          "inset-0",

          "bg-black/25",
        ].join(" ")}
      />


      {section.type ===
        "story" && (

        <div
          aria-hidden="true"

          className={[
            "absolute",

            "inset-0",

            "bg-primary/22",

            "mix-blend-multiply",
          ].join(" ")}
        />

      )}


      <div
        aria-hidden="true"

        className={[
          "absolute",

          "inset-0",

          isRight
            ? [
                "bg-gradient-to-r",
                "from-black/[0.05]",
                "via-black/18",
                "to-black/82",
              ].join(" ")

            : [
                "bg-gradient-to-r",
                "from-black/82",
                "via-black/20",
                "to-black/[0.05]",
              ].join(" "),
        ].join(" ")}
      />


      {/* ================================================================ */}
      {/* CONTENT                                                          */}
      {/* ================================================================ */}

      {/*
       * IMPORTANT:
       *
       * RollingPanel eventually moves -12vh.
       *
       * This content area begins +12vh inside
       * the visual.
       *
       * Once the incoming animation is complete:
       *
       * -12vh panel
       * +12vh content
       * ----------------
       * 0vh
       *
       * So the typography lands perfectly
       * in a normal viewport position.
       */}

      <div
        className={[
          "absolute",

          "left-0",
          "right-0",

          "top-[12svh]",

          "h-svh",
        ].join(" ")}
      >

        <Container
          className={[
            "grid",

            "h-full",

            "grid-cols-12",

            "items-center",

            "pb-16",
            "pt-32",
          ].join(" ")}
        >

          <div
            ref={contentRef}

            className={[
              "col-span-11",

              "max-w-[770px]",

              isRight
                ? [
                    "col-start-2",
                    "md:col-span-6",
                    "md:col-start-7",
                  ].join(" ")

                : [
                    "col-start-1",
                    "md:col-span-6",
                    "md:col-start-1",
                  ].join(" "),
            ].join(" ")}
          >

            <div
              className={[
                "mb-7",

                "flex",

                "items-center",

                "gap-4",
              ].join(" ")}
            >

              <span
                className={[
                  "font-body",

                  "text-[9px]",

                  "uppercase",

                  "tracking-[0.24em]",

                  "text-primary",
                ].join(" ")}
              >
                0{index + 1}
              </span>


              <span
                aria-hidden="true"

                className="h-px w-10 bg-primary"
              />


              <p
                className={[
                  "font-body",

                  "text-[10px]",

                  "uppercase",

                  "tracking-[0.25em]",

                  "text-white/65",
                ].join(" ")}
              >
                {
                  section.eyebrow
                }
              </p>

            </div>


            <h2
              className={[
                "font-display",

                "text-[clamp(4rem,7vw,8.4rem)]",

                "font-normal",

                "leading-[0.82]",

                "tracking-[-0.06em]",

                "drop-shadow-[0_4px_30px_rgba(0,0,0,0.42)]",
              ].join(" ")}
            >
              {
                section.title
              }
            </h2>


            {section.body && (

              <p
                className={[
                  "mt-8",

                  "max-w-[470px]",

                  "font-body",

                  "text-sm",

                  "leading-7",

                  "text-white/72",

                  "md:text-base",
                ].join(" ")}
              >
                {
                  section.body
                }
              </p>

            )}


            {"action" in section &&
              section.action && (

              <div className="mt-11">

                <PremiumHoverLink
                  href={
                    section.action.href
                  }

                  onHoverStart={
                    zoomIn
                  }

                  onHoverEnd={
                    zoomOut
                  }
                >
                  {
                    section.action.label
                  }
                </PremiumHoverLink>

              </div>

            )}

          </div>

        </Container>

      </div>

    </div>
  );
}
