"use client";

import Image from "next/image";

import {
  useLayoutEffect,
  useRef,
} from "react";

import gsap from "gsap";

import {
  ScrollTrigger,
} from "gsap/ScrollTrigger";

import type {
  GalleryTeaserContent,
  MenuTeaserContent,
  StorySectionContent,
} from "@/types/homepage";

import {
  Container,
} from "@/components/ui/Container";

import {
  PremiumHoverLink,
} from "@/components/ui/PremiumHoverLink";

gsap.registerPlugin(
  ScrollTrigger
);

type StackContent =
  | StorySectionContent
  | MenuTeaserContent
  | GalleryTeaserContent;

type Props = {
  section: StackContent;
  index: number;
};

export function StackSection({
  section,
  index,
}: Props) {
  const rootRef =
    useRef<HTMLElement>(null);

  /*
   * Incoming velocity boost.
   *
   * This layer visually begins above the
   * real section boundary.
   */
  const incomingRef =
    useRef<HTMLDivElement>(null);

  /*
   * Outgoing velocity lag.
   *
   * Counteracts a tiny amount of natural
   * upward document movement.
   */
  const outgoingRef =
    useRef<HTMLDivElement>(null);

  /*
   * Photography scroll parallax.
   */
  const parallaxRef =
    useRef<HTMLDivElement>(null);

  /*
   * CTA image hover.
   */
  const zoomRef =
    useRef<HTMLDivElement>(null);

  const contentRef =
    useRef<HTMLDivElement>(null);


  useLayoutEffect(() => {
    const reducedMotion =
      window.matchMedia(
        "(prefers-reduced-motion: reduce)"
      ).matches;

    if (reducedMotion) {
      return;
    }

    const context =
      gsap.context(() => {

        /* ============================================================= */
        /* INCOMING SECTION                                              */
        /* ============================================================= */

        /*
         * The visual already extends 12vh above
         * the section root.
         *
         * On top of that, we start it +5.5vh
         * lower and scrub that offset to zero.
         *
         * During roughly 12vh of real scrolling:
         *
         * natural movement = 12vh
         * GSAP movement    = 5.5vh
         *
         * visible movement ≈ 17.5vh
         *
         * Incoming scene therefore moves faster.
         */

        gsap.fromTo(
          incomingRef.current,

          {
            y: () =>
              window.innerHeight *
              0.055,
          },

          {
            y: 0,

            ease: "none",

            scrollTrigger: {
              trigger:
                rootRef.current,

              start:
                "top bottom",

              end: () =>
                `+=${
                  window.innerHeight *
                  0.12
                }`,

              scrub:
                0.32,

              invalidateOnRefresh:
                true,
            },
          }
        );


        /* ============================================================= */
        /* OUTGOING SECTION                                              */
        /* ============================================================= */

        /*
         * When the section becomes the outgoing
         * one, its visual moves a tiny amount
         * DOWN while the document moves UP.
         *
         * This means it leaves slightly slower.
         */

        gsap.fromTo(
          outgoingRef.current,

          {
            y: 0,
          },

          {
            y: () =>
              window.innerHeight *
              0.03,

            ease: "none",

            scrollTrigger: {
              trigger:
                rootRef.current,

              start:
                "top top",

              end: () =>
                `+=${
                  window.innerHeight *
                  0.16
                }`,

              scrub:
                0.45,

              invalidateOnRefresh:
                true,
            },
          }
        );


        /* ============================================================= */
        /* PHOTOGRAPH PARALLAX                                           */
        /* ============================================================= */

        gsap.set(
          parallaxRef.current,
          {
            scale:
              1.045,

            force3D:
              true,
          }
        );

        gsap.set(
          zoomRef.current,
          {
            scale:
              1,

            transformOrigin:
              "50% 50%",

            force3D:
              true,
          }
        );

        gsap.fromTo(
          parallaxRef.current,

          {
            yPercent:
              1.3,
          },

          {
            yPercent:
              -1.3,

            ease:
              "none",

            scrollTrigger: {
              trigger:
                rootRef.current,

              start:
                "top bottom",

              end:
                "bottom top",

              scrub:
                0.85,
            },
          }
        );


        /* ============================================================= */
        /* COPY REVEAL                                                   */
        /* ============================================================= */

        gsap.fromTo(
          contentRef.current,

          {
            y:
              38,

            opacity:
              0,
          },

          {
            y:
              0,

            opacity:
              1,

            duration:
              1.1,

            ease:
              "power4.out",

            scrollTrigger: {
              trigger:
                rootRef.current,

              start:
                "top 70%",

              toggleActions:
                "play none none reverse",
            },
          }
        );

      }, rootRef);


    return () => {
      context.revert();
    };

  }, []);


  /* ==================================================================== */
  /* CTA PHOTO ZOOM                                                       */
  /* ==================================================================== */

  function zoomIn() {
    gsap.to(
      zoomRef.current,
      {
        scale:
          1.035,

        duration:
          1.15,

        ease:
          "power3.out",

        overwrite:
          "auto",

        force3D:
          true,
      }
    );
  }


  function zoomOut() {
    gsap.to(
      zoomRef.current,
      {
        scale:
          1,

        duration:
          1.05,

        ease:
          "power3.inOut",

        overwrite:
          "auto",

        force3D:
          true,
      }
    );
  }


  const isRight =
    section.alignment ===
    "right";


  /*
   * Feathering is the important part.
   *
   * The panel starts 12svh above its real
   * section boundary.
   *
   * The top of that 12svh extension is
   * transparent and becomes fully opaque
   * before reaching the actual section.
   *
   * Therefore:
   *
   * previous image
   *       ↓
   * transparent incoming edge
   *       ↓
   * blended incoming image
   *       ↓
   * solid incoming image
   *
   * No hard horizontal line.
   */

  const mask =
    "linear-gradient(to bottom, transparent 0svh, rgba(0,0,0,0.18) 2svh, rgba(0,0,0,0.68) 6svh, #000 10svh, #000 100%)";


  return (

    /*
     * ====================================================================
     * NORMAL DOCUMENT SECTION
     * ====================================================================
     *
     * Nothing sticky.
     *
     * Every root scrolls normally.
     */

    <section
      id={
        section.id
      }

      ref={
        rootRef
      }

      data-stack-section

      className={[
        "relative",

        "h-svh",

        "overflow-visible",

        "text-white",
      ].join(" ")}

      style={{
        zIndex:
          20 +
          index * 10,
      }}
    >

      {/*
       * ==================================================================
       * VISUAL PANEL
       * ==================================================================
       *
       * Root = 100svh
       *
       * Visual = 112svh
       * Top = -12svh
       *
       * Therefore the upcoming scene physically
       * extends 12svh into the outgoing scene.
       */}

      <div
        ref={
          incomingRef
        }

        className={[
          "absolute",

          "left-0",

          "top-[-12svh]",

          "h-[112svh]",

          "w-full",

          "overflow-hidden",

          "will-change-transform",
        ].join(" ")}

        style={{
          maskImage:
            mask,

          WebkitMaskImage:
            mask,
        }}
      >

        {/* =============================================================== */}
        {/* OUTGOING LAG                                                    */}
        {/* =============================================================== */}

        <div
          ref={
            outgoingRef
          }

          className={[
            "absolute",

            "inset-0",

            "will-change-transform",
          ].join(" ")}
        >

          {/* ============================================================= */}
          {/* PARALLAX                                                      */}
          {/* ============================================================= */}

          <div
            ref={
              parallaxRef
            }

            className={[
              "absolute",

              "-inset-[4%]",

              "will-change-transform",
            ].join(" ")}
          >

            {/* =========================================================== */}
            {/* HOVER ZOOM                                                  */}
            {/* =========================================================== */}

            <div
              ref={
                zoomRef
              }

              className={[
                "absolute",

                "inset-0",

                "will-change-transform",
              ].join(" ")}
            >

              <Image
                src={
                  section.image.src
                }

                alt={
                  section.image.alt
                }

                fill

                sizes="100vw"

                className="object-cover"

                style={{
                  objectPosition:
                    `${
                      section.image
                        .focalPoint
                        ?.x ??
                      50
                    }% ${
                      section.image
                        .focalPoint
                        ?.y ??
                      50
                    }%`,
                }}
              />

            </div>

          </div>


          {/* ============================================================= */}
          {/* BASE IMAGE TREATMENT                                          */}
          {/* ============================================================= */}

          <div
            aria-hidden="true"

            className={[
              "absolute",

              "inset-0",

              "bg-black/25",
            ].join(" ")}
          />


          {section.type ===
            "story" && (

            <div
              aria-hidden="true"

              className={[
                "absolute",

                "inset-0",

                "bg-primary/24",

                "mix-blend-multiply",
              ].join(" ")}
            />

          )}


          {/* ============================================================= */}
          {/* COPY CONTRAST                                                  */}
          {/* ============================================================= */}

          <div
            aria-hidden="true"

            className={[
              "absolute",

              "inset-0",

              isRight

                ? [
                    "bg-gradient-to-r",

                    "from-black/[0.06]",

                    "via-black/18",

                    "to-black/82",
                  ].join(" ")

                : [
                    "bg-gradient-to-r",

                    "from-black/82",

                    "via-black/20",

                    "to-black/[0.06]",
                  ].join(" "),
            ].join(" ")}
          />


          {/*
           * ==============================================================
           * ACTUAL 100VH CONTENT AREA
           * ==============================================================
           *
           * The photo starts 12vh early.
           *
           * The copy does NOT.
           *
           * So typography remains aligned
           * to the actual section viewport.
           */}

          <div
            className={[
              "absolute",

              "left-0",

              "right-0",

              "top-[12svh]",

              "h-svh",
            ].join(" ")}
          >

            <Container
              className={[
                "grid",

                "h-full",

                "grid-cols-12",

                "items-center",

                "pb-16",

                "pt-32",
              ].join(" ")}
            >

              <div
                ref={
                  contentRef
                }

                className={[
                  "col-span-11",

                  "max-w-[770px]",

                  isRight

                    ? [
                        "col-start-2",

                        "md:col-span-6",

                        "md:col-start-7",
                      ].join(" ")

                    : [
                        "col-start-1",

                        "md:col-span-6",

                        "md:col-start-1",
                      ].join(" "),
                ].join(" ")}
              >


                {/* ======================================================= */}
                {/* EYEBROW                                                 */}
                {/* ======================================================= */}

                <div
                  className={[
                    "mb-7",

                    "flex",

                    "items-center",

                    "gap-4",
                  ].join(" ")}
                >

                  <span
                    className={[
                      "font-body",

                      "text-[9px]",

                      "uppercase",

                      "tracking-[0.24em]",

                      "text-primary",
                    ].join(" ")}
                  >
                    0{index + 1}
                  </span>


                  <span
                    aria-hidden="true"

                    className={[
                      "h-px",

                      "w-10",

                      "bg-primary",
                    ].join(" ")}
                  />


                  <p
                    className={[
                      "font-body",

                      "text-[10px]",

                      "uppercase",

                      "tracking-[0.25em]",

                      "text-white/65",
                    ].join(" ")}
                  >
                    {
                      section.eyebrow
                    }
                  </p>

                </div>


                {/* ======================================================= */}
                {/* HEADING                                                 */}
                {/* ======================================================= */}

                <h2
                  className={[
                    "font-display",

                    "text-[clamp(4rem,7vw,8.4rem)]",

                    "font-normal",

                    "leading-[0.82]",

                    "tracking-[-0.06em]",

                    "drop-shadow-[0_4px_30px_rgba(0,0,0,0.42)]",
                  ].join(" ")}
                >
                  {
                    section.title
                  }
                </h2>


                {/* ======================================================= */}
                {/* BODY                                                    */}
                {/* ======================================================= */}

                {section.body && (

                  <p
                    className={[
                      "mt-8",

                      "max-w-[470px]",

                      "font-body",

                      "text-sm",

                      "leading-7",

                      "text-white/72",

                      "md:text-base",
                    ].join(" ")}
                  >
                    {
                      section.body
                    }
                  </p>

                )}


                {/* ======================================================= */}
                {/* CTA                                                     */}
                {/* ======================================================= */}

                {"action" in section &&
                  section.action && (

                  <div className="mt-11">

                    <PremiumHoverLink
                      href={
                        section.action
                          .href
                      }

                      onHoverStart={
                        zoomIn
                      }

                      onHoverEnd={
                        zoomOut
                      }
                    >
                      {
                        section.action
                          .label
                      }
                    </PremiumHoverLink>

                  </div>

                )}

              </div>

            </Container>

          </div>

        </div>

      </div>

    </section>

  );

}
